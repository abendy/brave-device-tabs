{
  "manifest_version": 3,
  "name": "Device Tabs Picker",
  "description": "Select and open synced tabs from your other Brave devices.",
  "version": "1.0.1",
  "minimum_chrome_version": "88",
  "permissions": [
    "sessions",
    "tabs"
  ],
  "action": {
    "default_title": "Device Tabs Picker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
