.DS_Store
node_modules/
dist/
coverage/
.pnpm-store/

# Xcode — the whole .xcodeproj is generated by `xcodegen generate` (run from
# ios/), and picking a Team in Xcode writes it into project.pbxproj, so it
# can't be committed without also committing personal signing details.
# project.yml + the source files are the actual source of truth.
ios/*.xcodeproj/
ios/DerivedData/
ios/build/

# PocketBase local data (never commit real data/tokens)
server/pb_data/
