.DS_Store
node_modules/
dist/
coverage/

# Xcode — the whole .xcodeproj is generated by `xcodegen generate` (run from
# ios/) and re-embeds whatever DEVELOPMENT_TEAM is currently resolved into
# project.pbxproj on every regenerate, so it can't be committed without also
# committing personal signing details. project.yml + Local.xcconfig (also
# gitignored, see Local.xcconfig.example) + the source files are the actual
# source of truth.
ios/*.xcodeproj/
ios/DerivedData/
ios/build/
ios/build-device/
ios/build-simulator/
ios/Local.xcconfig
ios/Shared/DeploymentMarker.swift

# PocketBase local data (never commit real data/tokens)
server/pb_data/
